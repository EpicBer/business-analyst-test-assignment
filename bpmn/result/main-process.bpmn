<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_AccessPass" targetNamespace="https://example.org/bpmn/access-pass" exporter="Camunda Web Modeler" exporterVersion="7143633" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:error id="Error_RequiredReject" name="Отказ обязательного согласующего" errorCode="Error_RequiredReject" />
  <bpmn:error id="Error_Cancelled" name="Отмена инициатором" errorCode="Error_Cancelled" />
  <bpmn:message id="Message_Ready" name="Пропуск готов" />
  <bpmn:message id="Message_Arrival" name="Получатель прибыл" />
  <bpmn:message id="Message_NoPickup" name="Отказ от получения" />
  <bpmn:message id="Message_VisitorArrival" name="Посетитель прибыл" />
  <bpmn:message id="Message_Recall" name="Запрос досрочного отзыва" />
  <bpmn:message id="Message_Returned" name="Пропуск возвращён" />
  <bpmn:message id="Message_Lost" name="Пропуск потерян" />
  <bpmn:process id="Process_Main" name="Оформление и выдача пропуска" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Main">
      <bpmn:lane id="Lane_Extra" name="Дополнительные согласующие" />
      <bpmn:lane id="Lane_Manager" name="Руководитель подразделения" />
      <bpmn:lane id="Lane_Security" name="Служба безопасности">
        <bpmn:flowNodeRef>Gateway_VisitorSecurity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VisitorSecurity</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bureau" name="Бюро пропусков">
        <bpmn:flowNodeRef>Task_CheckDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocsOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Receive_Pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_VisitorMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MakePass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompareVisitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Receive_VisitorArrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandVisitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_VisitorIssued</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordIssue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Система">
        <bpmn:flowNodeRef>Task_CheckRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PickupEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Receive_NoPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Mandatory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_Additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyHost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrintVisitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Activate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BlockUnclaimed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Unclaimed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Issued</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_VisitCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_CancelMandatory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_RequiredReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_CancelAdditional</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Init" name="Инициатор">
        <bpmn:flowNodeRef>Start_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RequiredChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HostDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HostConfirms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectDocs</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Application" name="Потребность в пропуске">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Create" name="Создать и заполнить заявку">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Send" name="Отправить заявку">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CheckRequired" name="Проверить обязательные данные">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Complete" name="Достаточно данных?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_RequiredChoice" name="Повторно отправить?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CheckDocs" name="Проверить данные и документы">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DocsOK" name="Документы корректны?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_DocChoice" name="Повторно отправить?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cancelled" name="Отмена">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_NotifyReady" name="Уведомить инициатора и получателя">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_PickupEvent" name="Явка или отказ">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="Receive_Pickup" name="Получатель прибыл и предъявил документ">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="Receive_NoPickup" name="Получатель отказался забирать">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_VisitorMatch" name="Данные совпали?">
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
      <bpmn:outgoing>F38</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_HostDecision" name="Подтвердить изменения / отказаться">
      <bpmn:incoming>F39</bpmn:incoming>
      <bpmn:outgoing>F40</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_HostConfirms" name="Изменения подтверждены?">
      <bpmn:incoming>F40</bpmn:incoming>
      <bpmn:outgoing>F41</bpmn:outgoing>
      <bpmn:outgoing>F42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CorrectRequired" name="Исправить данные / отменить">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CorrectDocs" name="Исправить документы / отменить">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="Call_Mandatory" name="Обязательные согласования" calledElement="Process_Mandatory">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="Task_NotifyCancel" name="Закрыть отменённую заявку">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyReject" name="Уведомить о причине отказа">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Rejected" name="Отказ">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Call_Additional" name="Дополнительные согласования" calledElement="Process_Additional">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_Type" name="Тип пропуска?">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_MakePass" name="Изготовить постоянный / временный пропуск">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_CompareVisitor" name="Сверить оригинал документа с заявкой">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:outgoing>F36</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:receiveTask id="Receive_VisitorArrival" name="Посетитель прибыл на проходную">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Task_NotifyHost" name="Уведомить принимающего сотрудника">
      <bpmn:incoming>F38</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_PrintVisitor" name="Напечатать разовый пропуск">
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:incoming>F44</bpmn:incoming>
      <bpmn:outgoing>F46</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CloseVisit" name="Отменить посещение">
      <bpmn:incoming>F42</bpmn:incoming>
      <bpmn:incoming>F45</bpmn:incoming>
      <bpmn:outgoing>F48</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_VisitorSecurity" name="СБ согласовала?">
      <bpmn:incoming>F43</bpmn:incoming>
      <bpmn:outgoing>F44</bpmn:outgoing>
      <bpmn:outgoing>F45</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_VisitorSecurity" name="Повторно проверить изменённые данные">
      <bpmn:incoming>F41</bpmn:incoming>
      <bpmn:outgoing>F43</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_VerifyIssue" name="Сверить документ">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_HandVisitor" name="Выдать разовый пропуск">
      <bpmn:incoming>F46</bpmn:incoming>
      <bpmn:outgoing>F47</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="End_VisitorIssued" name="Разовый выдан">
      <bpmn:incoming>F47</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_RecordIssue" name="Зафиксировать выдачу">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Activate" name="Активировать разрешённые права в СКУД">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_BlockUnclaimed" name="Заблокировать пропуск и закрыть заявку">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Unclaimed" name="Не получен">
      <bpmn:incoming>F33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Issued" name="Выдан и активирован">
      <bpmn:incoming>F31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_VisitCancelled" name="Посещение отменено">
      <bpmn:incoming>F48</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_CancelMandatory" attachedToRef="Call_Mandatory">
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Cancelled" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_RequiredReject" attachedToRef="Call_Mandatory">
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_RequiredReject" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_CancelAdditional" attachedToRef="Call_Additional">
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Cancelled" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Application" targetRef="Task_Create" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Create" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Send" targetRef="Task_CheckRequired" />
    <bpmn:sequenceFlow id="F8" name="Да" sourceRef="Gateway_RequiredChoice" targetRef="Task_CheckRequired" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_CheckRequired" targetRef="Gateway_Complete" />
    <bpmn:sequenceFlow id="F5" name="Да" sourceRef="Gateway_Complete" targetRef="Task_CheckDocs" />
    <bpmn:sequenceFlow id="F6" name="Нет" sourceRef="Gateway_Complete" targetRef="Task_CorrectRequired" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_CorrectRequired" targetRef="Gateway_RequiredChoice" />
    <bpmn:sequenceFlow id="F9" name="Нет" sourceRef="Gateway_RequiredChoice" targetRef="End_Cancelled" />
    <bpmn:sequenceFlow id="F14" name="Да" sourceRef="Gateway_DocChoice" targetRef="Task_CheckDocs" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_CheckDocs" targetRef="Gateway_DocsOK" />
    <bpmn:sequenceFlow id="F11" name="Да" sourceRef="Gateway_DocsOK" targetRef="Call_Mandatory" />
    <bpmn:sequenceFlow id="F12" name="Нет" sourceRef="Gateway_DocsOK" targetRef="Task_CorrectDocs" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_CorrectDocs" targetRef="Gateway_DocChoice" />
    <bpmn:sequenceFlow id="F15" name="Нет" sourceRef="Gateway_DocChoice" targetRef="End_Cancelled" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_NotifyCancel" targetRef="End_Cancelled" />
    <bpmn:sequenceFlow id="F24" sourceRef="Task_MakePass" targetRef="Task_NotifyReady" />
    <bpmn:sequenceFlow id="F25" sourceRef="Task_NotifyReady" targetRef="Gateway_PickupEvent" />
    <bpmn:sequenceFlow id="F26" name="Явка" sourceRef="Gateway_PickupEvent" targetRef="Receive_Pickup" />
    <bpmn:sequenceFlow id="F27" name="Отказ" sourceRef="Gateway_PickupEvent" targetRef="Receive_NoPickup" />
    <bpmn:sequenceFlow id="F28" sourceRef="Receive_Pickup" targetRef="Task_VerifyIssue" />
    <bpmn:sequenceFlow id="F32" sourceRef="Receive_NoPickup" targetRef="Task_BlockUnclaimed" />
    <bpmn:sequenceFlow id="F36" sourceRef="Task_CompareVisitor" targetRef="Gateway_VisitorMatch" />
    <bpmn:sequenceFlow id="F37" name="Да" sourceRef="Gateway_VisitorMatch" targetRef="Task_PrintVisitor" />
    <bpmn:sequenceFlow id="F38" name="Нет" sourceRef="Gateway_VisitorMatch" targetRef="Task_NotifyHost" />
    <bpmn:sequenceFlow id="F39" sourceRef="Task_NotifyHost" targetRef="Task_HostDecision" />
    <bpmn:sequenceFlow id="F40" sourceRef="Task_HostDecision" targetRef="Gateway_HostConfirms" />
    <bpmn:sequenceFlow id="F41" name="Подтвердить" sourceRef="Gateway_HostConfirms" targetRef="Task_VisitorSecurity" />
    <bpmn:sequenceFlow id="F42" name="Отказаться" sourceRef="Gateway_HostConfirms" targetRef="Task_CloseVisit" />
    <bpmn:sequenceFlow id="F16" name="Согласовано" sourceRef="Call_Mandatory" targetRef="Call_Additional" />
    <bpmn:sequenceFlow id="F20" sourceRef="Boundary_CancelAdditional" targetRef="Task_NotifyCancel" />
    <bpmn:sequenceFlow id="F19" sourceRef="Boundary_CancelMandatory" targetRef="Task_NotifyCancel" />
    <bpmn:sequenceFlow id="F17" sourceRef="Boundary_RequiredReject" targetRef="Task_NotifyReject" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_NotifyReject" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F22" sourceRef="Call_Additional" targetRef="Gateway_Type" />
    <bpmn:sequenceFlow id="F23" name="Постоянный / временный" sourceRef="Gateway_Type" targetRef="Task_MakePass" />
    <bpmn:sequenceFlow id="F34" name="Разовый" sourceRef="Gateway_Type" targetRef="Receive_VisitorArrival" />
    <bpmn:sequenceFlow id="F35" sourceRef="Receive_VisitorArrival" targetRef="Task_CompareVisitor" />
    <bpmn:sequenceFlow id="F44" name="Согласовано" sourceRef="Gateway_VisitorSecurity" targetRef="Task_PrintVisitor" />
    <bpmn:sequenceFlow id="F46" sourceRef="Task_PrintVisitor" targetRef="Task_HandVisitor" />
    <bpmn:sequenceFlow id="F45" name="Отказ" sourceRef="Gateway_VisitorSecurity" targetRef="Task_CloseVisit" />
    <bpmn:sequenceFlow id="F48" sourceRef="Task_CloseVisit" targetRef="End_VisitCancelled" />
    <bpmn:sequenceFlow id="F43" sourceRef="Task_VisitorSecurity" targetRef="Gateway_VisitorSecurity" />
    <bpmn:sequenceFlow id="F29" sourceRef="Task_VerifyIssue" targetRef="Task_RecordIssue" />
    <bpmn:sequenceFlow id="F47" sourceRef="Task_HandVisitor" targetRef="End_VisitorIssued" />
    <bpmn:sequenceFlow id="F30" sourceRef="Task_RecordIssue" targetRef="Task_Activate" />
    <bpmn:sequenceFlow id="F31" sourceRef="Task_Activate" targetRef="End_Issued" />
    <bpmn:sequenceFlow id="F33" sourceRef="Task_BlockUnclaimed" targetRef="End_Unclaimed" />
  </bpmn:process>
  <bpmn:process id="Process_Mandatory" name="Обязательные согласования" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Mandatory">
      <bpmn:lane id="Lane_Mand_Init" name="Инициатор">
        <bpmn:flowNodeRef>Task_ProvideInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InfoChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InfoCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChangeZones</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ZoneChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ZoneCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideRecheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RecheckChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RecheckCancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mand_Sec" name="Служба безопасности">
        <bpmn:flowNodeRef>Task_SecReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SecResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SecReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SecRecheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RecheckResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RecheckReject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mand_Mgr" name="Руководитель подразделения">
        <bpmn:flowNodeRef>Task_MgrReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MgrResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_MgrReject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mand_System" name="Система">
        <bpmn:flowNodeRef>Start_Mandatory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MandSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MandJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NewHigh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_MandatoryApproved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Mandatory" name="После проверки документов">
      <bpmn:outgoing>MA1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_MandSplit" name="Параллельно">
      <bpmn:incoming>MA1</bpmn:incoming>
      <bpmn:outgoing>MA2</bpmn:outgoing>
      <bpmn:outgoing>MA3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_SecReview" name="Проверить заявку">
      <bpmn:incoming>MA2</bpmn:incoming>
      <bpmn:incoming>MA9</bpmn:incoming>
      <bpmn:outgoing>MA4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_SecResult" name="Решение СБ">
      <bpmn:incoming>MA4</bpmn:incoming>
      <bpmn:outgoing>MA5</bpmn:outgoing>
      <bpmn:outgoing>MA6</bpmn:outgoing>
      <bpmn:outgoing>MA7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ProvideInfo" name="Предоставить дополнительные сведения">
      <bpmn:incoming>MA7</bpmn:incoming>
      <bpmn:outgoing>MA8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_InfoChoice" name="Продолжить?">
      <bpmn:incoming>MA8</bpmn:incoming>
      <bpmn:outgoing>MA9</bpmn:outgoing>
      <bpmn:outgoing>MA10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_SecReject" name="Отказ СБ">
      <bpmn:incoming>MA6</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_RequiredReject" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_InfoCancel" name="Отмена">
      <bpmn:incoming>MA10</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_Cancelled" />
    </bpmn:endEvent>
    <bpmn:userTask id="Task_MgrReview" name="Согласовать заявку и зоны">
      <bpmn:incoming>MA3</bpmn:incoming>
      <bpmn:incoming>MA16</bpmn:incoming>
      <bpmn:outgoing>MA11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MgrResult" name="Решение руководителя">
      <bpmn:incoming>MA11</bpmn:incoming>
      <bpmn:outgoing>MA12</bpmn:outgoing>
      <bpmn:outgoing>MA13</bpmn:outgoing>
      <bpmn:outgoing>MA14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ChangeZones" name="Изменить зоны доступа">
      <bpmn:incoming>MA14</bpmn:incoming>
      <bpmn:outgoing>MA15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ZoneChoice" name="Продолжить?">
      <bpmn:incoming>MA15</bpmn:incoming>
      <bpmn:outgoing>MA16</bpmn:outgoing>
      <bpmn:outgoing>MA17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_MgrReject" name="Отказ руководителя">
      <bpmn:incoming>MA13</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_RequiredReject" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_ZoneCancel" name="Отмена">
      <bpmn:incoming>MA17</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_Cancelled" />
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gateway_MandJoin" name="Оба согласования завершены">
      <bpmn:incoming>MA5</bpmn:incoming>
      <bpmn:incoming>MA12</bpmn:incoming>
      <bpmn:outgoing>MA18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_NewHigh" name="Добавлена новая зона повышенной безопасности?">
      <bpmn:incoming>MA18</bpmn:incoming>
      <bpmn:outgoing>MA19</bpmn:outgoing>
      <bpmn:outgoing>MA20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SecRecheck" name="Повторно проверить новые зоны / данные">
      <bpmn:incoming>MA20</bpmn:incoming>
      <bpmn:incoming>MA26</bpmn:incoming>
      <bpmn:outgoing>MA21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RecheckResult" name="Решение СБ">
      <bpmn:incoming>MA21</bpmn:incoming>
      <bpmn:outgoing>MA22</bpmn:outgoing>
      <bpmn:outgoing>MA23</bpmn:outgoing>
      <bpmn:outgoing>MA24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ProvideRecheck" name="Предоставить сведения">
      <bpmn:incoming>MA24</bpmn:incoming>
      <bpmn:outgoing>MA25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RecheckChoice" name="Продолжить?">
      <bpmn:incoming>MA25</bpmn:incoming>
      <bpmn:outgoing>MA26</bpmn:outgoing>
      <bpmn:outgoing>MA27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RecheckReject" name="Отказ СБ">
      <bpmn:incoming>MA23</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_RequiredReject" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_RecheckCancel" name="Отмена">
      <bpmn:incoming>MA27</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_Cancelled" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_MandatoryApproved" name="Обязательные согласования пройдены">
      <bpmn:incoming>MA19</bpmn:incoming>
      <bpmn:incoming>MA22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="MA1" sourceRef="Start_Mandatory" targetRef="Gateway_MandSplit" />
    <bpmn:sequenceFlow id="MA2" name="СБ" sourceRef="Gateway_MandSplit" targetRef="Task_SecReview" />
    <bpmn:sequenceFlow id="MA3" name="Руководитель" sourceRef="Gateway_MandSplit" targetRef="Task_MgrReview" />
    <bpmn:sequenceFlow id="MA4" sourceRef="Task_SecReview" targetRef="Gateway_SecResult" />
    <bpmn:sequenceFlow id="MA5" name="Согласовать" sourceRef="Gateway_SecResult" targetRef="Gateway_MandJoin" />
    <bpmn:sequenceFlow id="MA6" name="Отказать" sourceRef="Gateway_SecResult" targetRef="End_SecReject" />
    <bpmn:sequenceFlow id="MA7" name="Запросить сведения" sourceRef="Gateway_SecResult" targetRef="Task_ProvideInfo" />
    <bpmn:sequenceFlow id="MA8" sourceRef="Task_ProvideInfo" targetRef="Gateway_InfoChoice" />
    <bpmn:sequenceFlow id="MA9" name="Предоставить" sourceRef="Gateway_InfoChoice" targetRef="Task_SecReview" />
    <bpmn:sequenceFlow id="MA10" name="Отменить" sourceRef="Gateway_InfoChoice" targetRef="End_InfoCancel" />
    <bpmn:sequenceFlow id="MA11" sourceRef="Task_MgrReview" targetRef="Gateway_MgrResult" />
    <bpmn:sequenceFlow id="MA12" name="Согласовать" sourceRef="Gateway_MgrResult" targetRef="Gateway_MandJoin" />
    <bpmn:sequenceFlow id="MA13" name="Отказать" sourceRef="Gateway_MgrResult" targetRef="End_MgrReject" />
    <bpmn:sequenceFlow id="MA14" name="Изменить зоны" sourceRef="Gateway_MgrResult" targetRef="Task_ChangeZones" />
    <bpmn:sequenceFlow id="MA15" sourceRef="Task_ChangeZones" targetRef="Gateway_ZoneChoice" />
    <bpmn:sequenceFlow id="MA16" name="Повторно" sourceRef="Gateway_ZoneChoice" targetRef="Task_MgrReview" />
    <bpmn:sequenceFlow id="MA17" name="Отменить" sourceRef="Gateway_ZoneChoice" targetRef="End_ZoneCancel" />
    <bpmn:sequenceFlow id="MA18" sourceRef="Gateway_MandJoin" targetRef="Gateway_NewHigh" />
    <bpmn:sequenceFlow id="MA19" name="Нет" sourceRef="Gateway_NewHigh" targetRef="End_MandatoryApproved" />
    <bpmn:sequenceFlow id="MA20" name="Да" sourceRef="Gateway_NewHigh" targetRef="Task_SecRecheck" />
    <bpmn:sequenceFlow id="MA21" sourceRef="Task_SecRecheck" targetRef="Gateway_RecheckResult" />
    <bpmn:sequenceFlow id="MA22" name="Согласовать" sourceRef="Gateway_RecheckResult" targetRef="End_MandatoryApproved" />
    <bpmn:sequenceFlow id="MA23" name="Отказать" sourceRef="Gateway_RecheckResult" targetRef="End_RecheckReject" />
    <bpmn:sequenceFlow id="MA24" name="Сведения" sourceRef="Gateway_RecheckResult" targetRef="Task_ProvideRecheck" />
    <bpmn:sequenceFlow id="MA25" sourceRef="Task_ProvideRecheck" targetRef="Gateway_RecheckChoice" />
    <bpmn:sequenceFlow id="MA26" name="Предоставить" sourceRef="Gateway_RecheckChoice" targetRef="Task_SecRecheck" />
    <bpmn:sequenceFlow id="MA27" name="Отменить" sourceRef="Gateway_RecheckChoice" targetRef="End_RecheckCancel" />
  </bpmn:process>
  <bpmn:process id="Process_Additional" name="Дополнительные согласования" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Additional">
      <bpmn:lane id="Lane_Add_Init" name="Инициатор">
        <bpmn:flowNodeRef>Task_NoZonesDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ContinueNoZones</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AddCancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Add_System" name="Система">
        <bpmn:flowNodeRef>Start_Additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CarRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RemoveCar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ZonesRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AnyZone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ZonesMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Additional</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Add_Transport" name="Транспортная служба">
        <bpmn:flowNodeRef>Task_TransportReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CarAllowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CarMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Add_Owners" name="Ответственные за специальные зоны">
        <bpmn:flowNodeRef>SubProcess_EachZone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Additional" name="После обязательных согласований">
      <bpmn:outgoing>AD1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_AddSplit" name="Параллельно">
      <bpmn:incoming>AD1</bpmn:incoming>
      <bpmn:outgoing>AD2</bpmn:outgoing>
      <bpmn:outgoing>AD3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_CarRequested" name="Запрошен автомобиль?">
      <bpmn:incoming>AD2</bpmn:incoming>
      <bpmn:outgoing>AD4</bpmn:outgoing>
      <bpmn:outgoing>AD5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_TransportReview" name="Разрешить / запретить въезд">
      <bpmn:incoming>AD4</bpmn:incoming>
      <bpmn:outgoing>AD6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_CarAllowed" name="Въезд разрешён?">
      <bpmn:incoming>AD6</bpmn:incoming>
      <bpmn:outgoing>AD7</bpmn:outgoing>
      <bpmn:outgoing>AD8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RemoveCar" name="Исключить автомобиль; сохранить пешеходный пропуск">
      <bpmn:incoming>AD8</bpmn:incoming>
      <bpmn:outgoing>AD9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ZonesRequested" name="Есть специальные зоны?">
      <bpmn:incoming>AD3</bpmn:incoming>
      <bpmn:outgoing>AD10</bpmn:outgoing>
      <bpmn:outgoing>AD11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess_EachZone" name="Для каждой зоны: согласовать; при отказе исключить зону">
      <bpmn:incoming>AD10</bpmn:incoming>
      <bpmn:outgoing>AD12</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
      <bpmn:startEvent id="Start_ZoneInstance" name="Зона выбрана" />
      <bpmn:userTask id="Task_ZoneOwnerReview" name="Ответственный согласует зону" />
      <bpmn:exclusiveGateway id="Gateway_ZoneAllowed" name="Зона разрешена?" />
      <bpmn:serviceTask id="Task_ExcludeZone" name="Исключить отклонённую зону" />
      <bpmn:endEvent id="End_ZoneAllowed" name="Решение сохранено" />
      <bpmn:endEvent id="End_ZoneExcluded" name="Зона исключена" />
      <bpmn:sequenceFlow id="ZI1" sourceRef="Start_ZoneInstance" targetRef="Task_ZoneOwnerReview" />
      <bpmn:sequenceFlow id="ZI2" sourceRef="Task_ZoneOwnerReview" targetRef="Gateway_ZoneAllowed" />
      <bpmn:sequenceFlow id="ZI3" name="Да" sourceRef="Gateway_ZoneAllowed" targetRef="End_ZoneAllowed" />
      <bpmn:sequenceFlow id="ZI4" name="Нет" sourceRef="Gateway_ZoneAllowed" targetRef="Task_ExcludeZone" />
      <bpmn:sequenceFlow id="ZI5" sourceRef="Task_ExcludeZone" targetRef="End_ZoneExcluded" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_AnyZone" name="Осталась разрешённая специальная зона?">
      <bpmn:incoming>AD12</bpmn:incoming>
      <bpmn:outgoing>AD13</bpmn:outgoing>
      <bpmn:outgoing>AD14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_NoZonesDecision" name="Продолжить без специальных зон / отменить">
      <bpmn:incoming>AD14</bpmn:incoming>
      <bpmn:outgoing>AD15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ContinueNoZones" name="Продолжить?">
      <bpmn:incoming>AD15</bpmn:incoming>
      <bpmn:outgoing>AD16</bpmn:outgoing>
      <bpmn:outgoing>AD17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_AddCancel" name="Отмена">
      <bpmn:incoming>AD17</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_Cancelled" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_CarMerge" name="Результат транспорта">
      <bpmn:incoming>AD5</bpmn:incoming>
      <bpmn:incoming>AD7</bpmn:incoming>
      <bpmn:incoming>AD9</bpmn:incoming>
      <bpmn:outgoing>AD18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_ZonesMerge" name="Результат зон">
      <bpmn:incoming>AD11</bpmn:incoming>
      <bpmn:incoming>AD13</bpmn:incoming>
      <bpmn:incoming>AD16</bpmn:incoming>
      <bpmn:outgoing>AD19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_AddJoin" name="Все применимые согласования завершены">
      <bpmn:incoming>AD18</bpmn:incoming>
      <bpmn:incoming>AD19</bpmn:incoming>
      <bpmn:outgoing>AD20</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_Additional" name="Дополнительные согласования завершены">
      <bpmn:incoming>AD20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="AD1" sourceRef="Start_Additional" targetRef="Gateway_AddSplit" />
    <bpmn:sequenceFlow id="AD2" name="Автомобиль" sourceRef="Gateway_AddSplit" targetRef="Gateway_CarRequested" />
    <bpmn:sequenceFlow id="AD3" name="Зоны" sourceRef="Gateway_AddSplit" targetRef="Gateway_ZonesRequested" />
    <bpmn:sequenceFlow id="AD4" name="Да" sourceRef="Gateway_CarRequested" targetRef="Task_TransportReview" />
    <bpmn:sequenceFlow id="AD5" name="Нет" sourceRef="Gateway_CarRequested" targetRef="Gateway_CarMerge" />
    <bpmn:sequenceFlow id="AD6" sourceRef="Task_TransportReview" targetRef="Gateway_CarAllowed" />
    <bpmn:sequenceFlow id="AD7" name="Да" sourceRef="Gateway_CarAllowed" targetRef="Gateway_CarMerge" />
    <bpmn:sequenceFlow id="AD8" name="Нет" sourceRef="Gateway_CarAllowed" targetRef="Task_RemoveCar" />
    <bpmn:sequenceFlow id="AD9" name="Продолжить пешком" sourceRef="Task_RemoveCar" targetRef="Gateway_CarMerge" />
    <bpmn:sequenceFlow id="AD10" name="Да" sourceRef="Gateway_ZonesRequested" targetRef="SubProcess_EachZone" />
    <bpmn:sequenceFlow id="AD11" name="Нет" sourceRef="Gateway_ZonesRequested" targetRef="Gateway_ZonesMerge" />
    <bpmn:sequenceFlow id="AD12" sourceRef="SubProcess_EachZone" targetRef="Gateway_AnyZone" />
    <bpmn:sequenceFlow id="AD13" name="Да" sourceRef="Gateway_AnyZone" targetRef="Gateway_ZonesMerge" />
    <bpmn:sequenceFlow id="AD14" name="Нет" sourceRef="Gateway_AnyZone" targetRef="Task_NoZonesDecision" />
    <bpmn:sequenceFlow id="AD15" sourceRef="Task_NoZonesDecision" targetRef="Gateway_ContinueNoZones" />
    <bpmn:sequenceFlow id="AD16" name="Без зон" sourceRef="Gateway_ContinueNoZones" targetRef="Gateway_ZonesMerge" />
    <bpmn:sequenceFlow id="AD17" name="Отменить" sourceRef="Gateway_ContinueNoZones" targetRef="End_AddCancel" />
    <bpmn:sequenceFlow id="AD18" sourceRef="Gateway_CarMerge" targetRef="Gateway_AddJoin" />
    <bpmn:sequenceFlow id="AD19" sourceRef="Gateway_ZonesMerge" targetRef="Gateway_AddJoin" />
    <bpmn:sequenceFlow id="AD20" sourceRef="Gateway_AddJoin" targetRef="End_Additional" />
  </bpmn:process>
  <bpmn:process id="Process_Recall" name="Досрочный отзыв выданного пропуска" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Recall">
      <bpmn:lane id="Lane_Recall_Requester" name="Руководитель / HR / СБ">
        <bpmn:flowNodeRef>Start_Recall</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Recall_System" name="Система">
        <bpmn:flowNodeRef>Task_BlockNow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyReturn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReturnEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lost</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Recall_Bureau" name="Бюро пропусков">
        <bpmn:flowNodeRef>Receive_Returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Receive_Lost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordReturn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterLoss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Recalled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Recall" name="Запрос досрочного отзыва">
      <bpmn:outgoing>RE1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Recall" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_BlockNow" name="Немедленно заблокировать пропуск в СКУД">
      <bpmn:incoming>RE1</bpmn:incoming>
      <bpmn:outgoing>RE2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_NotifyReturn" name="Уведомить о необходимости возврата">
      <bpmn:incoming>RE2</bpmn:incoming>
      <bpmn:outgoing>RE3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_ReturnEvent" name="Возврат или потеря">
      <bpmn:incoming>RE3</bpmn:incoming>
      <bpmn:outgoing>RE4</bpmn:outgoing>
      <bpmn:outgoing>RE5</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="Receive_Returned" name="Физический пропуск возвращён">
      <bpmn:incoming>RE4</bpmn:incoming>
      <bpmn:outgoing>RE6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="Receive_Lost" name="Получено сообщение о потере">
      <bpmn:incoming>RE5</bpmn:incoming>
      <bpmn:outgoing>RE8</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Task_RecordReturn" name="Зафиксировать возврат">
      <bpmn:incoming>RE6</bpmn:incoming>
      <bpmn:outgoing>RE7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RegisterLoss" name="Зарегистрировать потерю">
      <bpmn:incoming>RE8</bpmn:incoming>
      <bpmn:outgoing>RE9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CreateInvestigation" name="Создать задачу на внутреннее расследование">
      <bpmn:incoming>RE9</bpmn:incoming>
      <bpmn:outgoing>RE10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Recalled" name="Отозван и возвращён">
      <bpmn:incoming>RE7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Lost" name="Отозван; потеря расследуется">
      <bpmn:incoming>RE10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="RE1" sourceRef="Start_Recall" targetRef="Task_BlockNow" />
    <bpmn:sequenceFlow id="RE2" sourceRef="Task_BlockNow" targetRef="Task_NotifyReturn" />
    <bpmn:sequenceFlow id="RE3" sourceRef="Task_NotifyReturn" targetRef="Gateway_ReturnEvent" />
    <bpmn:sequenceFlow id="RE4" name="Возвращён" sourceRef="Gateway_ReturnEvent" targetRef="Receive_Returned" />
    <bpmn:sequenceFlow id="RE5" name="Потерян" sourceRef="Gateway_ReturnEvent" targetRef="Receive_Lost" />
    <bpmn:sequenceFlow id="RE6" sourceRef="Receive_Returned" targetRef="Task_RecordReturn" />
    <bpmn:sequenceFlow id="RE7" sourceRef="Task_RecordReturn" targetRef="End_Recalled" />
    <bpmn:sequenceFlow id="RE8" sourceRef="Receive_Lost" targetRef="Task_RegisterLoss" />
    <bpmn:sequenceFlow id="RE9" sourceRef="Task_RegisterLoss" targetRef="Task_CreateInvestigation" />
    <bpmn:sequenceFlow id="RE10" sourceRef="Task_CreateInvestigation" targetRef="End_Lost" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Main" name="Оформление и выдача пропуска">
    <bpmn:participant id="Participant_Enterprise_Main" name="Предприятие" processRef="Process_Main" />
    <bpmn:participant id="Participant_Recipient_Main" name="Получатель / посетитель" />
    <bpmn:messageFlow id="MF_Ready" name="Пропуск готов" sourceRef="Task_NotifyReady" targetRef="Participant_Recipient_Main" />
    <bpmn:messageFlow id="MF_Arrival" name="Явка и документ" sourceRef="Participant_Recipient_Main" targetRef="Receive_Pickup" />
    <bpmn:messageFlow id="MF_NoPickup" name="Отказ от получения" sourceRef="Participant_Recipient_Main" targetRef="Receive_NoPickup" />
    <bpmn:messageFlow id="MF_VisitorArrival" name="Прибытие посетителя" sourceRef="Participant_Recipient_Main" targetRef="Receive_VisitorArrival" />
  </bpmn:collaboration>
  <bpmn:collaboration id="Collaboration_Mandatory" name="Обязательные согласования">
    <bpmn:participant id="Participant_Mandatory" name="Предприятие" processRef="Process_Mandatory" />
  </bpmn:collaboration>
  <bpmn:collaboration id="Collaboration_Additional" name="Дополнительные согласования">
    <bpmn:participant id="Participant_Additional" name="Предприятие" processRef="Process_Additional" />
  </bpmn:collaboration>
  <bpmn:collaboration id="Collaboration_Recall" name="Досрочный отзыв выданного пропуска">
    <bpmn:participant id="Participant_Enterprise_Recall" name="Предприятие" processRef="Process_Recall" />
    <bpmn:participant id="Participant_Recipient_Recall" name="Получатель пропуска" />
    <bpmn:messageFlow id="MF_ReturnRequest" name="Требование вернуть пропуск" sourceRef="Task_NotifyReturn" targetRef="Participant_Recipient_Recall" />
    <bpmn:messageFlow id="MF_Returned" name="Возврат" sourceRef="Participant_Recipient_Recall" targetRef="Receive_Returned" />
    <bpmn:messageFlow id="MF_Lost" name="Сообщение о потере" sourceRef="Participant_Recipient_Recall" targetRef="Receive_Lost" />
  </bpmn:collaboration>
